#cloud-config
autoinstall:
  version: 1
  refresh-installer:
    update: false
  source:
    id: ubuntu-desktop
    search_drivers: false
  apt:
    geoip: false
    mirror-selection:
      primary:
        - uri: "http://127.0.0.1/ubuntu-offline"
    fallback: offline-install
  drivers:
    install: false
  locale: en_US.UTF-8
  keyboard:
    layout: it
    variant: ""
  timezone: Europe/Rome
  network:
    version: 2
    ethernets: {}
  identity:
    hostname: yoga
    username: yoga
    password: "$6$fywbi1lu3Ea97e9V$4hq1EHmuvkk3/lX9TUyuvnr4eleA76apESfZZioPUn2X0FMOCa5guFWvw7i6QS9vOwdFPwgE9hfWfHi7V1HjV."
  early-commands:
    - /bin/sh /cdrom/nocloud/verify-target.sh "$(cat /cdrom/nocloud/guard-mode)" "/dev/yogabook-emmc"
  storage:
    layout:
      name: direct
      match:
        path: "/dev/yogabook-emmc"
  late-commands:
    - install -d /target/opt/yoga-book-debs
    - cp -a /cdrom/pool/yoga-book/. /target/opt/yoga-book-debs/
    - curtin in-target --target=/target -- sh -c 'printf "%s\n" "deb [trusted=yes] file:/opt/yoga-book-debs ./" > /tmp/yoga-book-offline.list'
    - curtin in-target --target=/target -- apt-get -o Dir::Etc::sourcelist=/tmp/yoga-book-offline.list -o Dir::Etc::sourceparts=- -o APT::Get::List-Cleanup=0 update
    - curtin in-target --target=/target -- sh -c 'DEBIAN_FRONTEND=noninteractive apt-get -o Dir::Etc::sourcelist=/tmp/yoga-book-offline.list -o Dir::Etc::sourceparts=- install --yes alsa-ucm-conf-yogabook linux-headers-6.17.4-yogabook1 linux-image-6.17.4-yogabook1 touch-keyboard yogabook-support'
    - curtin in-target --target=/target -- dpkg-query -W alsa-ucm-conf-yogabook linux-headers-6.17.4-yogabook1 linux-image-6.17.4-yogabook1 touch-keyboard yogabook-support
    - curtin in-target --target=/target -- test -s /boot/vmlinuz-6.17.4-yogabook1
    - curtin in-target --target=/target -- test -s /boot/initrd.img-6.17.4-yogabook1
    - curtin in-target --target=/target -- sh -c 'find /boot -maxdepth 1 -type f -name "vmlinuz-7.0.0-*-generic" -print -quit | grep -q .'
    - curtin in-target --target=/target -- sh -c 'printf "%s\n" "GRUB_TOP_LEVEL=/boot/vmlinuz-6.17.4-yogabook1" > /etc/default/grub.d/60-yogabook.cfg'
    - sh -c 'if [ "$(cat /cdrom/nocloud/guard-mode)" = test ]; then printf "%s\n" "GRUB_CMDLINE_LINUX_DEFAULT=\"console=tty0 console=ttyS0\"" > /target/etc/default/grub.d/61-yogabook-vm-test.cfg; install -m 0755 /cdrom/nocloud/vm-verify.sh /target/usr/local/sbin/yogabook-vm-verify; install -m 0644 /cdrom/nocloud/yogabook-vm-verify.service /target/etc/systemd/system/yogabook-vm-verify.service; curtin in-target --target=/target -- systemctl enable yogabook-vm-verify.service; fi'
    - curtin in-target --target=/target -- update-grub
    - curtin in-target --target=/target -- sh -c 'test -z "$(dpkg --audit)"'
    - curtin in-target --target=/target -- apt-get --no-download check
    - install -d /target/var/log/installer/autoinstall-media
    - cp /cdrom/pool/yoga-book/packages.manifest /target/var/log/installer/autoinstall-media/packages.manifest
    - cp /cdrom/nocloud/user-data /target/var/log/installer/autoinstall-media/user-data
    - rm -rf /target/opt/yoga-book-debs
  shutdown: poweroff
